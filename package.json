{
  "name": "mcp-oauth-provider",
  "version": "0.1.0",
  "description": "Add ngrok-managed OAuth to a local MCP server without changing its code",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/ngrok-adhoc/mcp-oauth-provider.git"
  },
  "bin": {
    "mcp-oauth-provider": "bin/mcp-oauth-provider.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "README.md",
    ".env.example"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "check": "npm run format:check && npm run lint && npm test"
  },
  "dependencies": {
    "@ngrok/ngrok": "1.8.0",
    "oidc-provider": "9.15.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=24"
  }
}
